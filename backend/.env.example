# Copy this file to backend/.env and fill in real values before running.

# Postgres: postgresql://<user>:<password>@<host>:5432/<dbname>
# Quick local demo instead: sqlite:///./nodonomy.db
DATABASE_URL=postgresql://nodonomy:nodonomy@localhost:5432/nodonomy

# Generate a real secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-in-production
JWT_EXPIRE_MINUTES=60

MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=nodonomy

NODE_OFFLINE_TIMEOUT_SECONDS=120
LOW_BATTERY_THRESHOLD=20
HIGH_SOUND_THRESHOLD=75.0
HIGH_TEMP_THRESHOLD=45.0
